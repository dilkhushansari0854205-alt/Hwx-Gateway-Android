rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper: checks if authenticated user strictly matches the path owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Top-level user document
    // Users may read their own profile, but all mutations (stats, status, role)
    // must be strictly executed by the backend server via Firebase Admin SDK.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Block direct client mutation of status, stats, and metadata

      // Subcollections: Read-only for the owner; written solely by backend API to prevent
      // forgery of API key hashes, device tokens, SMS dispatch jobs, and webhook logs.
      match /apiKeys/{keyId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /devices/{deviceId} {
        allow read: if isOwner(userId);
        allow write: if false;

        match /sims/{simId} {
          allow read: if isOwner(userId);
          allow write: if false;
        }
      }

      match /bots/{botId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /smsMessages/{messageId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /smsJobs/{jobId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /webhooks/{webhookId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /webhookDeliveries/{deliveryId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Backend-only lookup indexes: block direct client SDK reads/writes
    match /apiKeyLookups/{lookupId} {
      allow read, write: if false;
    }

    match /deviceLookups/{lookupId} {
      allow read, write: if false;
    }

    // Deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
